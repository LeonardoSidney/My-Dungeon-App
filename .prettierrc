{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "*.ts",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "tabWidth": 2,
        "printWidth": 120
      }
    }
  ]
}
